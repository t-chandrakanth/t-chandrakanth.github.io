# Random string, 32+ chars. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Storage (Upstash Redis via Vercel Marketplace sets these automatically).
# Without them the app uses temporary in-memory storage (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Which team this deployment serves: ti-goods (default), victor or coal. See lib/config.ts.
NEXT_PUBLIC_TEAM=ti-goods

# Daily duty alerts (web push). Generate once with: npx web-push generate-vapid-keys
# The same pair can be used by all three apps. CRON_SECRET protects /api/push/send.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
