# Random string, 32+ chars. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Storage (Upstash Redis via Vercel Marketplace sets these automatically).
# Without them the app uses temporary in-memory storage (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Which team this deployment serves: ti-goods (default) or victor. See lib/config.ts.
NEXT_PUBLIC_TEAM=ti-goods
