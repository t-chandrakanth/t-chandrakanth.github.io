# Random string, 32+ chars. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# One PIN per person (4+ digits). Raghav's PIN unlocks all controls.
PIN_RAGHAV=
PIN_MAHESH=
PIN_VISHNU=
PIN_NARENDRA=
PIN_SUBBAREDDY=
PIN_TEJA=

# Storage (Upstash Redis via Vercel Marketplace sets these automatically).
# Without them the app uses temporary in-memory storage (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
